                <div>
                    <label class="block font-medium text-slate-600 mb-1">Seu Nome (Remetente):</label>
                    <input type="text" id="inputSender" class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-sage-400" placeholder="Ex: Lucas" required>
                </div>

                <div>
                    <label class="block font-medium text-slate-600 mb-1">Seu WhatsApp (com DDD):</label>
                    <input type="tel" id="inputPhone" class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-sage-400" placeholder="Ex: 5511999999999" required>
                    <span class="text-[10px] text-slate-400">Inclua o 55 + DDD + Número.</span>
                </div>

                <div class="pt-2 flex justify-end gap-2">
                    <button type="button" onclick="closeEditModal()" class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600">
                        Cancelar
                    </button>
                    <button type="submit" class="px-4 py-1.5 rounded-lg bg-sage-500 text-white font-medium shadow-md">
                        Salvar ✨
                    </button>
