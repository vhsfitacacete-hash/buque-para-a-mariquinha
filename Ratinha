            </div>

            <form onsubmit="saveCustomization(event)" class="space-y-3 text-xs">
                <div>
                    <label class="block font-medium text-slate-600 mb-1">Nome Dela (Destinatária):</label>
                    <input type="text" id="inputRecipient" class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-sage-400" placeholder="Ex: Sofia" required>
