    <!-- MODAL DE PERSONALIZAÇÃO (Aparece ao clicar na engrenagem) -->
    <div id="editModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
        <div id="editModalContent" class="bg-white max-w-sm w-full rounded-2xl p-5 shadow-2xl border border-slate-100 transform scale-95 transition-transform duration-300">
            
            <div class="flex justify-between items-center mb-3 pb-2 border-b border-slate-100">
                <h3 class="font-semibold text-slate-800 text-sm flex items-center gap-2">
                    <i class="fa-solid fa-sliders text-sage-500"></i>
                    Personalizar Cartão
                </h3>
                <button onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark"></i>
